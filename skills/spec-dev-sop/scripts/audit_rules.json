{
  "version": 1,
  "_comment": [
    "spec-dev-sop 质量体检规则。改这个文件即可迭代检查项，不用改代码。",
    "字段说明见 references/audit-playbook.md。",
    "severity: blocker（必须修）/ warning（大概率要修）/ info（提示）。",
    "allow_pattern: 命中该正则的行直接跳过，用于压制误报，优先于改规则。"
  ],
  "scan": {
    "exclude_glob": [
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "*.min.js",
      "*.min.css",
      "*.map",
      "*.svg",
      "*.zip",
      "docs/dev/**"
    ],
    "max_file_kb": 512
  },
  "secrets": [
    {
      "id": "hardcoded-credential",
      "severity": "blocker",
      "pattern": "(?i)\\b(api[_-]?key|apikey|secret[_-]?key|app[_-]?secret|access[_-]?token|auth[_-]?token|password|passwd|pwd)\\b\\s*[:=]\\s*['\"][^'\"\\s]{6,}['\"]",
      "allow_pattern": "(os\\.environ|os\\.getenv|process\\.env|import\\.meta\\.env|getenv\\(|config\\(|%[({]|\\{\\{|your[_-]|placeholder|example|changeme|\\bx{4,}\\b|<[A-Z_]+>)",
      "message": "硬编码口令/密钥，改为读环境变量"
    },
    {
      "id": "private-key",
      "severity": "blocker",
      "pattern": "-----BEGIN (RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----",
      "message": "私钥内容出现在仓库里"
    },
    {
      "id": "db-url-with-password",
      "severity": "blocker",
      "pattern": "(?i)\\b(mysql|postgres(ql)?|mongodb(\\+srv)?|redis|amqp)://[^:\\s/'\"]+:[^@\\s/'\"]{3,}@",
      "allow_pattern": "(os\\.environ|getenv|\\{\\{|<[A-Z_]+>)",
      "message": "连接串里带明文密码"
    },
    {
      "id": "aws-access-key",
      "severity": "blocker",
      "pattern": "\\bAKIA[0-9A-Z]{16}\\b",
      "message": "疑似 AWS Access Key"
    },
    {
      "id": "google-api-key",
      "severity": "blocker",
      "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b",
      "message": "疑似 Google API Key"
    },
    {
      "id": "github-token",
      "severity": "blocker",
      "pattern": "\\bgh[pousr]_[0-9A-Za-z]{36,}\\b",
      "message": "疑似 GitHub Token"
    },
    {
      "id": "slack-token",
      "severity": "blocker",
      "pattern": "\\bxox[baprs]-[0-9A-Za-z-]{10,}",
      "message": "疑似 Slack Token"
    },
    {
      "id": "django-secret-key",
      "severity": "warning",
      "pattern": "^\\s*SECRET_KEY\\s*=\\s*['\"][^'\"]{20,}",
      "allow_pattern": "django-insecure",
      "message": "SECRET_KEY 写死在 settings.py，生产应读环境变量"
    },
    {
      "id": "jwt-token",
      "severity": "warning",
      "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b",
      "allow_pattern": "(test|fixture|example|dummy)",
      "message": "疑似真实 JWT，确认是否测试夹具"
    },
    {
      "id": "cn-id-card",
      "severity": "warning",
      "pattern": "\\b[1-9]\\d{5}(19|20)\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])\\d{3}[\\dXx]\\b",
      "exclude_glob": ["test_*.py", "**/test_*.py", "**/tests/**", "*.test.js", "*.spec.js", "**/fixtures/**"],
      "message": "疑似身份证号，检查是否为真实个人信息"
    },
    {
      "id": "cn-phone",
      "severity": "warning",
      "pattern": "\\b1[3-9]\\d{9}\\b",
      "exclude_glob": ["test_*.py", "**/test_*.py", "**/tests/**", "*.test.js", "*.spec.js", "**/fixtures/**"],
      "message": "疑似手机号，检查是否为真实个人信息"
    },
    {
      "id": "hardcoded-ip",
      "severity": "warning",
      "pattern": "\\b(?:https?|wss?)://(?:\\d{1,3}\\.){3}\\d{1,3}(?::\\d+)?",
      "allow_pattern": "(127\\.0\\.0\\.1|0\\.0\\.0\\.0|localhost|example)",
      "message": "硬编码 IP 地址，改为配置项"
    }
  ],
  "debug": [
    {
      "id": "python-pdb",
      "severity": "blocker",
      "langs": ["python"],
      "pattern": "(pdb\\.set_trace\\(\\)|(^|\\s)breakpoint\\(\\)|^\\s*import pdb\\b)",
      "message": "调试代码残留，提交前必须删除"
    },
    {
      "id": "js-debugger",
      "severity": "blocker",
      "langs": ["js"],
      "pattern": "^\\s*debugger\\s*;?\\s*$",
      "message": "debugger 语句残留"
    },
    {
      "id": "python-print",
      "severity": "warning",
      "langs": ["python"],
      "skip_tests": true,
      "pattern": "^\\s*print\\(",
      "allow_pattern": "(if __name__|# noqa|verbose)",
      "exclude_glob": [
        "scripts/**",
        "**/scripts/**",
        "skills/**",
        "manage.py",
        "**/manage.py",
        "**/conftest.py",
        "**/setup.py",
        "**/wsgi.py",
        "**/asgi.py"
      ],
      "message": "print 调试输出，改用 logging"
    },
    {
      "id": "js-console",
      "severity": "warning",
      "langs": ["js"],
      "skip_tests": true,
      "pattern": "console\\.(log|debug|trace)\\(",
      "allow_pattern": "(// *no-?console|eslint-disable)",
      "exclude_glob": ["scripts/**", "**/scripts/**", "**/*.config.js"],
      "message": "console 调试输出，生产环境应移除"
    }
  ],
  "markers": [
    {
      "id": "todo-marker",
      "severity": "info",
      "pattern": "\\b(TODO|FIXME|HACK|XXX)\\b",
      "exclude_glob": ["**/audit_rules.json", "docs/**"],
      "message": "遗留标记，确认是否要在本次收尾"
    }
  ],
  "redundancy": {
    "min_commented_block": 4,
    "dup_window": 6,
    "dup_min_chars": 120,
    "max_function_lines": 60,
    "max_file_lines": 800,
    "file_exempt_glob": []
  },
  "structure": {
    "check_python_deps": true,
    "check_django_apps": true,
    "check_django_settings": true,
    "check_frontend_deps": true,
    "check_env": true,
    "check_orphans": false,
    "check_doc_names": true,
    "frontend_ignore_deps": []
  },
  "style": {
    "max_line_length": 120,
    "check_trailing_whitespace": true,
    "check_final_newline": true,
    "check_mixed_indent": true
  }
}
